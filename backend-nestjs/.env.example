# Configuracion del backend NestJS
# Copia este archivo a .env y ajusta segun tu entorno.

# Opcion 1: cadena completa (ideal para RDS u otros servicios administrados)
#DATABASE_URL=postgres://usuario:clave@host:5432/base

# Opcion 2: variables individuales (se respetan en orden y tienen valores por defecto para docker-compose)
#PGHOST=localhost
#PGPORT=5432
#PGDATABASE=poc_concurrency
#PGUSER=postgres
#PGPASSWORD=postgres

# Control de logs de TypeORM (true/false)
TYPEORM_LOGGING=false

# Puerto HTTP del servicio NestJS
PORT=3000

# Api key opcional para proteger el endpoint (dejala vacia para desactivarla)
API_KEY=
